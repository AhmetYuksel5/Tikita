rules_version = '2';
// ============================================================
//  Tikita — Firestore güvenlik kuralları
//  DURUM: Uygulama henüz Firebase Authentication kullanmıyor; istemci
//  anonim bağlanıyor. Bu yüzden "auth gerektiren" kurallar uygulamayı
//  kırar. Aşağıdaki açık kural geçicidir.
//
//  Ara önlem (uygulandı): kullanıcı PIN'leri düz metin değil; tuzlu
//  SHA-256 özet (pinHash/pinSalt) olarak saklanır.
//
//  KALICI ÇÖZÜM (yol haritası):
//   1) Firebase Authentication'ı aç.
//   2) Giriş ekranını Auth ile entegre et.
//   3) Aşağıdaki yorumlu kuralları aç:  firebase deploy --only firestore:rules
//        function signedIn() { return request.auth != null; }
//        match /{document=**} { allow read, write: if signedIn(); }
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {
    // 📜 Değişiklik kaydı (audit) — silinemez ve geriye dönük değiştirilemez.
    //  create: serbest (her yazım log düşer)
    //  update: yalnız "geri alındı" damgası (undone/undoneTs/undoneBy)
    //  delete: KAPALI — defterin bütünlüğü bozulamaz.
    match /audit_logs/{log} {
      allow read, create: if request.time < timestamp.date(2030, 1, 1);
      allow update: if request.time < timestamp.date(2030, 1, 1)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['undone', 'undoneTs', 'undoneBy']);
      allow delete: if false;
    }
    // Geçici açık erişim (gerçek auth eklenene kadar).
    // DİKKAT: çakışan match'lerden biri izin verirse yazım GEÇER — bu yüzden
    // audit_logs genel yazım kuralının DIŞINDA tutulur (üstteki dar kural tek kapı).
    match /{coll}/{doc=**} {
      allow read: if request.time < timestamp.date(2030, 1, 1);
      allow write: if request.time < timestamp.date(2030, 1, 1) && coll != 'audit_logs';
    }
  }
}
